<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Factory.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Anthropic.Vertex" />
    <PackageReference Include="Microsoft.AgentGovernance" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- Per-role tool policies (AcsToolPolicy.DefaultDirectory), shipped next to every host. -->
    <None Include="../../policies/s2/*.yaml" Link="policies/s2/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Factory.Core/Factory.Core.fsproj" />
  </ItemGroup>

</Project>
